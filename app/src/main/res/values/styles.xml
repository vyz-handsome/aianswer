<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_deep</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Kartu kaca: latar digambar GlassDrawable (blur aurora + frost + rim + kilau). -->
    <style name="Card">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_ui</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="PageTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="SectionSub">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Btn" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Btn.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/accent_deep</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:padding">13dp</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink3</item>
    </style>

    <!-- ===== Popup kaca (liquid glass) ===== -->
    <style name="GlassDialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/glass_enter</item>
        <item name="android:windowExitAnimation">@anim/glass_exit</item>
    </style>

    <style name="GlassButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/glass_btn</item>
        <item name="android:textColor">@color/accent_deep</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GlassDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_bg_solid</item>
        <item name="android:windowAnimationStyle">@style/GlassDialogAnim</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.22</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="colorAccent">@color/accent_deep</item>
        <item name="buttonBarButtonStyle">@style/GlassButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/GlassButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/GlassButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/GlassButton</item>
    </style>
</resources>
