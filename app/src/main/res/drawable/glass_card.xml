<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu kaca untuk popup overlay (menu tekan lama, panel jawaban) tanpa inset. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#EBEAF6FF"
                android:startColor="#F0F3EEFF" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1.2dp"
                android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item android:height="46dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#70FFFFFF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
