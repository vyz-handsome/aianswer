<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F6F4FFFF" android:centerColor="#E5F5FFFF" android:endColor="#DDE3FAFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1.2dp" android:color="#DDFFFFFF" />
        </shape>
    </item>
    <item android:height="42dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
