<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F4F1FF" android:centerColor="#E5E9FF" android:endColor="#D7F3FF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#A9A0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F6FFFFFF" android:endColor="#D9F0F8FF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#BFFFFFFF" />
        </shape>
    </item>
</selector>
