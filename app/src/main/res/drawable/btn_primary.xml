<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#7468F7" android:endColor="#3F86F4" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="#88FFFFFF" />
                </shape>
            </item>
            <item android:height="26dp" android:gravity="top" android:left="2dp" android:right="2dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="25dp" android:topRightRadius="25dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
